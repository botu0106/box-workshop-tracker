# Copy this file to .env and change the values. Never commit .env.

# Local PostgreSQL in Docker (docker-compose.yml reads these)
POSTGRES_USER=workshop
POSTGRES_PASSWORD=change_me
POSTGRES_DB=workshop_db
DB_HOST=localhost
DB_PORT=5433

# Flask session signing key. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_secret

# --- Cloud only (set in the hosting platform, not in .env) ---
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
#   When set, it is used instead of the local DB_* settings.
# APP_ENV=production
#   Turns on secure cookies, HSTS and the proxy settings, and refuses to start
#   without a real SECRET_KEY.
